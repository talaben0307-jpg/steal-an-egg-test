-- 4. TAB: SPECIAL EGGS & ALL BIOMES
-- ==========================================
Tabs.Special:AddSection("All Biomes Loop")
Tabs.Special:AddButton({
    Title = "🔥 Auto Farm Quét Lần Lượt Cả 13 Biome",
    Callback = function()
        task.spawn(function()
            local list = {"Forest","Desert","Snow","Volcano","Jungle","Ocean","Swamp","Mushroom","Candy","Cyber","Mystic","Heaven","Void"}
            while task.wait(0.5) do
                for _, bName in ipairs(list) do
                    AutoFarmTarget(bName, false)
                end
            end
        end)
    end
})

Tabs.Special:AddSection("Event & Rare Eggs")
Tabs.Special:AddButton({
    Title = "⭐ Auto Farm Trứng Đặc Biệt / Rare",
    Callback = function()
        task.spawn(function()
            while task.wait(1) do AutoFarmTarget("Special", true) end
        end)
    end
})

-- ==========================================
-- 5. TAB: MISC & ESP (Speed, Instant Interact, ESP)
-- ==========================================
Tabs.Misc:AddSection("Player Speed Control (Bypass Kick)")

local speedEnabled = false
local currentSpeed = 32

Tabs.Misc:AddButton({
    Title = "⚡ Bật / Tắt WalkSpeed Safe (Tốc độ x2)",
    Callback = function()
        speedEnabled = not speedEnabled
        if speedEnabled then
            task.spawn(function()
                local RunService = game:GetService("RunService")
                while speedEnabled do
                    local char = game.Players.LocalPlayer.Character
                    if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                        local hum = char.Humanoid
                        if hum.MoveDirection.Magnitude > 0 then
                            char:TranslateBy(hum.MoveDirection * (currentSpeed / 16))
                        end
                    end
                    RunService.RenderStepped:Wait()
                end
            end)
        end
    end
})

Tabs.Misc:AddButton({ Title = "🚀 Tăng tốc độ cực nhanh (Tốc độ x3)", Callback = function() currentSpeed = 48 end })
Tabs.Misc:AddButton({ Title = "🔄 Đưa tốc độ về Bình thường", Callback = function() currentSpeed = 16 speedEnabled = false end })

Tabs.Misc:AddSection("Interaction Tools")
Tabs.Misc:AddButton({
    Title = "⚡ Bật Instant Interact (Không cần giữ phím E)",
    Callback = function()
        pcall(function()
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") then v.HoldDuration = 0 end
            end
            workspace.DescendantAdded:Connect(function(v)
                if v:IsA("ProximityPrompt") then v.HoldDuration = 0 end
            end)
        end)
    end
})

Tabs.Misc:AddSection("Egg ESP System")
Tabs.Misc:AddButton({
    Title = "👁️ Bật ESP Trứng Toàn Bản Đồ (Realtime)",
    Callback = function()
        pcall(function()
            local CoreGui = game:GetService("CoreGui")
            if CoreGui:FindFirstChild("EggESPFolder") then CoreGui.EggESPFolder:Destroy() end

            local ESPFolder = Instance.new("Folder")
            ESPFolder.Name = "EggESPFolder"
            ESPFolder.Parent = CoreGui

            local function CreateHighlight(eggModel)
                if eggModel:IsA("Model") and not eggModel:FindFirstChild("EggHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "EggHighlight"
                    hl.Adornee = eggModel
                    hl.FillColor = Color3.fromRGB(0, 255, 255)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.4
                    hl.Parent = eggModel
                end
            end

            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and (obj.Name:lower():find("egg") or obj:FindFirstChild("TouchInterest")) then
                    CreateHighlight(obj)
                end
            end

            workspace.DescendantAdded:Connect(function(obj)
                task.wait(0.1)
                if obj:IsA("Model") and (obj.Name:lower():find("egg") or obj:FindFirstChild("TouchInterest")) then
                    CreateHighlight(obj)
                end
            end)
        end)
    end
})

-- Mặc định chọn tab đầu tiên
Window:SelectTab(1)
