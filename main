-- ==========================================
-- 1. BYPASS ANTI-CHEAT CO BAN
-- ==========================================
pcall(function()
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and (self.Name:lower():find("anticheat") or self.Name:lower():find("speed") or self.Name:lower():find("teleport") or self.Name:lower():find("check")) then
            return
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end)

-- ==========================================
-- 2. TẢI THƯ VIỆN CPZMENU
-- ==========================================
local success, CPZMenu = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/talaben0307-jpg/cpzmenu/refs/heads/main/menu"))()
end)

if not success or not CPZMenu then
    warn("[ERROR] Khong the tai thu vien CPZMenu! Kiem tra lai link raw.")
    return
end

-- Khởi tạo Window
local Window = CPZMenu:CreateWindow({
    Title = "Steal An Egg Ultimate Hub",
    SubTitle = "⚡ 13 Biomes Complete Edition"
})

-- ==========================================
-- 3. HÀM FARM VÀ DỊCH CHUYỂN
-- ==========================================
local function AutoFarmTarget(targetName, isSpecial)
    pcall(function()
        local folder = workspace:FindFirstChild("Eggs") or workspace:FindFirstChild("Biomes") or workspace
        for _, obj in pairs(folder:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name:lower():find(targetName:lower()) or (isSpecial and obj:FindFirstChild("Special"))) then
                if obj.PrimaryPart and game.Players.LocalPlayer.Character then
                    local hrp = game.Players.LocalPlayer.Character.HumanoidRootPart
                    local tweenService = game:GetService("TweenService")
                    local info = TweenInfo.new(0.15, Enum.EasingStyle.Linear)
                    local tween = tweenService:Create(hrp, info, {CFrame = obj.PrimaryPart.CFrame})
                    tween:Play()
                    task.wait(0.2)
                end
            end
        end
    end)
end

-- ==========================================
-- 4. KHỞI TẠO TAB & TÍNH NĂNG
-- ==========================================
local Tabs = {
    Biomes1 = Window:AddTab({ Title = "Biomes [1-5]" }),
    Biomes2 = Window:AddTab({ Title = "Biomes [6-10]" }),
    Biomes3 = Window:AddTab({ Title = "Biomes [11-13]" }),
    Special = Window:AddTab({ Title = "Special Eggs ⭐" }),
    Misc = Window:AddTab({ Title = "Misc & ESP 👁️" })
}

-- TAB 1: Biomes 1-5
Tabs.Biomes1:AddSection("1. Forest Biome")
Tabs.Biomes1:AddButton({ Title = "🥚 Auto Farm - Forest", Callback = function() task.spawn(function() while task.wait(1) do AutoFarmTarget("Forest", false) end end) end })

Tabs.Biomes1:AddSection("2. Desert Biome")
Tabs.Biomes1:AddButton({ Title = "🌵 Auto Farm - Desert", Callback = function() task.spawn(function() while task.wait(1) do AutoFarmTarget("Desert", false) end end) end })

