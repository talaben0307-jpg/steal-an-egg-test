-- ==========================================
-- BYPASS ANTI-CHEAT (Chặn báo cáo vị trí / tốc độ)
-- ==========================================
pcall(function()
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and (self.Name:lower():find("anticheat") or self.Name:lower():find("speed") or self.Name:lower():find("teleport") or self.Name:lower():find("check")) then
            return
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end)

local CPZMenu = loadstring(game:HttpGet("https://raw.githubusercontent.com/talaben0307-jpg/cpzmenu/refs/heads/main/menu"))()

-- Tạo Window Cyberpunk cho Steal An Egg Ultimate
local Window = CPZMenu:CreateWindow({
    Title = "Steal An Egg Ultimate Hub",
    SubTitle = "⚡ 13 Biomes Complete Edition"
})

-- Hàm dịch chuyển nhặt trứng bằng Tween mượt mà
local function AutoFarmTarget(targetName, isSpecial)
    pcall(function()
        local folder = workspace:FindFirstChild("Eggs") or workspace:FindFirstChild("Biomes") or workspace
        for _, obj in pairs(folder:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name:lower():find(targetName:lower()) or (isSpecial and obj:FindFirstChild("Special"))) then
                if obj.PrimaryPart and game.Players.LocalPlayer.Character then
                    local hrp = game.Players.LocalPlayer.Character.HumanoidRootPart
                    local tweenService = game:GetService("TweenService")
                    local info = TweenInfo.new(0.15, Enum.EasingStyle.Linear)
                    local tween = tweenService:Create(hrp, info, {CFrame = obj.PrimaryPart.CFrame})
                    tween:Play()
                    task.wait(0.2)
                end
            end
        end
    end)
end

-- ==========================================
-- KHỞI TẠO CÁC TAB CHỨC NĂNG
-- ==========================================
local Tabs = {
    Biomes1 = Window:AddTab({ Title = "Biomes [1-5]" }),
